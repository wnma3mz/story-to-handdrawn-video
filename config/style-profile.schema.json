{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-to-handdrawn-video.local/style-profile.schema.json",
  "title": "Story to Hand-drawn Video Style Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "description",
    "base_mode",
    "recommended_for",
    "style_overrides",
    "episode_defaults",
    "editorial"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "base_mode": {
      "enum": ["diary", "essay", "ink-comic"]
    },
    "recommended_for": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "style_overrides": {
      "type": "object"
    },
    "episode_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent", "cover"],
      "properties": {
        "accent": {
          "$ref": "#/$defs/hexColor"
        },
        "color_grade": {
          "enum": ["monochrome", "warm_bronze", "snow_cinnabar"]
        },
        "cover": {
          "$ref": "#/$defs/cover"
        }
      }
    },
    "editorial": {
      "type": "object"
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "series_title": {"type": "string", "minLength": 1},
        "episode_label": {"type": "string", "minLength": 1},
        "episode_number": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "background": {"$ref": "#/$defs/hexColor"},
        "accent": {"$ref": "#/$defs/hexColor"},
        "dark_accent": {"$ref": "#/$defs/hexColor"},
        "badge": {"$ref": "#/$defs/hexColor"},
        "card": {"$ref": "#/$defs/hexColor"},
        "foreground": {"$ref": "#/$defs/hexColor"}
      }
    }
  }
}
